{
  "name": "topview",
  "version": "0.1.0",
  "private": true,
  "description": "TopView desktop application",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.cjs dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "preview": "node scripts/run-electron-vite.cjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-postgis": "^0.2.5",
    "@geoman-io/leaflet-geoman-free": "^2.20.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.topview.desktop",
    "productName": "TopView",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/dist/**/*",
      "node_modules/@electric-sql/pglite-postgis/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TopView-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TopView",
      "deleteAppDataOnUninstall": false
    }
  }
}
